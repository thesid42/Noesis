# Copy to .env. Keep credentials out of chat, source control, and browser responses.
NOESIS_HOST=127.0.0.1
NOESIS_PORT=8765
NOESIS_DATA_DIR=data/ami/ES2002a
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Configure Kimi for the default local Flower runtime. MiniMax is optional in
# local mode; configure both to enable UI switching. Keys stay in the loopback
# Noesis model gateway; they are never sent in Grid tasks or returned by the API.
NOESIS_MODEL_PROFILE=
NEBIUS_KIMI_API_ENDPOINT=
NEBIUS_KIMI_MODEL=
NEBIUS_KIMI_API_KEY=
NEBIUS_MINIMAX_API_ENDPOINT=
NEBIUS_MINIMAX_MODEL=
NEBIUS_MINIMAX_API_KEY=

