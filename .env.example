# Copy to .env. Keep credentials out of chat, source control, and browser responses.
NOESIS_HOST=127.0.0.1
NOESIS_PORT=8765
NOESIS_DATA_DIR=data/ami/ES2002a
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Optional Nebius profiles. `python scripts/configure_nebius.py --profile kimi`
# selects a configured profile; alternatively run `./start.ps1 -ModelProfile kimi`.
# The API keys are read only to configure Flower SuperLink and are never sent in
# AgentApp prompts or returned by the Noesis API.
NOESIS_MODEL_PROFILE=
NEBIUS_KIMI_API_ENDPOINT=
NEBIUS_KIMI_MODEL=
NEBIUS_KIMI_API_KEY=
NEBIUS_MINIMAX_API_ENDPOINT=
NEBIUS_MINIMAX_MODEL=
NEBIUS_MINIMAX_API_KEY=

